{
  "name": "opencode-search",
  "version": "1.1.0-next.1",
  "description": "OpenCode plugin that provides search tools for Firecrawl web search, Google News, Wikipedia, Bluesky, MDN Web Docs, the AWS documentation, and the IETF, W3C and WHATWG specifications.",
  "keywords": [
    "atproto",
    "aws",
    "bluesky",
    "firecrawl",
    "google-news",
    "ietf",
    "mdn",
    "opencode",
    "opencode-plugin",
    "plugin",
    "rfc",
    "search",
    "specifications",
    "w3c",
    "whatwg",
    "wikipedia"
  ],
  "homepage": "https://github.com/whaaaley/opencode-search#readme",
  "bugs": {
    "url": "https://github.com/whaaaley/opencode-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whaaaley/opencode-search.git"
  },
  "license": "MIT",
  "author": "Dustin Dowell",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/search.d.mts",
      "import": "./dist/search.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/search.mjs",
  "types": "./dist/search.d.mts",
  "files": [
    "dist",
    "README.md",
    "REMOVED.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "vp check",
    "typecheck": "tsc",
    "test": "vp test --project unit",
    "test:integration": "vp test --run --project integration",
    "test:coverage": "vp test --project unit --coverage",
    "record": "vp test --run --mode record --project 'crush*'",
    "build": "vp pack",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.10",
    "jsdom": "26.1.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
