{
  "name": "opencode-search",
  "version": "1.0.0-next.0",
  "author": "Dustin Dowell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whaaaley/opencode-search.git"
  },
  "main": "./dist/search.js",
  "dependencies": {
    "@mozilla/readability": "0.5.0",
    "jsdom": "26.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/jsdom": "27.0.0",
    "dprint": "latest",
    "typescript": "5.9.3",
    "@opencode/plugin": "2.0.10"
  },
  "exports": {
    ".": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    }
  },
  "bugs": {
    "url": "https://github.com/whaaaley/opencode-search/issues"
  },
  "description": "OpenCode plugin that provides web search tools using DuckDuckGo, Google, Wikipedia, Bluesky, Standard.site, and MDN Web Docs.",
  "files": [
    "dist/",
    "README.md",
    "REMOVED.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/whaaaley/opencode-search#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "search",
    "web-search",
    "wikipedia",
    "duckduckgo",
    "google",
    "bluesky",
    "atproto",
    "standard-site"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "fmt": "bun run dprint fmt",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "types": "./dist/search.d.ts",
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
